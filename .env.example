# Set to your real production origin before deploying (https://…; no trailing path).
# Vercel's VERCEL_PROJECT_PRODUCTION_URL is used automatically when SITE_URL is unset.
# Without either value, local metadata uses http://localhost:3000 and indexing is disabled.
SITE_URL=

# Optional override; defaults to the studio's supplied address below.
# An explicitly empty CONTACT_EMAIL disables the email CTA.
CONTACT_EMAIL=octavian@sneakersgames.com
